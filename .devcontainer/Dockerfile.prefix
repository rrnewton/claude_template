
# [RRN] node image has too old versions for certain packages we use:
# FROM node:25
# [revival 2026-06-16] Bumped 25.10 (questing, interim) -> 26.04 (resolute, new LTS).
FROM ubuntu:26.04

# [RRN] TZ confuses happy-coder
# ARG TZ
# ENV TZ="$TZ"

# Stolen from the nodejs/docker/node Dockerfile:
# RUN groupadd --gid 1000 node \
#   && useradd --uid 1000 --gid node --shell /bin/bash --create-home node

# Install basic development tools and iptables/ipset
RUN apt-get update && apt-get install -y --no-install-recommends \
  less \
  git \
  procps \
  sudo \
  fzf \
  zsh \
  man-db \
  unzip \
  gnupg2 \
  gh \
  iptables \
  ipset \
  iproute2 \
  dnsutils \
  aggregate \
  jq \
  nano \
  vim \
  tmux \
  wget \
  curl \
  libatomic1 \
  cron \
  rsync
  # libatomic1: required at runtime by the Node 26+ prebuilt binary
  # (libatomic.so.1); Node 24 did not need it.
  #
  # cron + rsync are NOT optional extras, they are BAKED ON PURPOSE (ds-3ij3j4).
  #   cron:  `/` is an overlay that is discarded on container recreation and
  #          there is no init system, so a hand `apt-get install cron` silently
  #          evaporates. On 2026-07-21 exactly that happened and the production
  #          Cloudflare D1 user-database backup did not run for a month.
  #          The DAEMON still has to be started explicitly -- provision.sh does
  #          that on every container start.
  #   rsync: a hard requirement of the project's scripts/deploy-cloud.sh; without
  #          it this host simply cannot deploy.
  # [RRN ] Don't clean because we want to keep apt and I don't mind if claude
  # installs either:
  # && apt-get clean && rm -rf /var/lib/apt/lists/*

ARG TZ_NAME=America/New_York
RUN ln -sf /usr/share/zoneinfo/$TZ_NAME /etc/localtime && echo $TZ_NAME > /etc/timezone

# Installs a TON of stufF:
# RUN apt-get install -y npm

# Going to a newer version for github copilot
RUN apt-get install -y ca-certificates && \
     curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash

ARG NODE_VERSION=26

RUN . "$HOME/.nvm/nvm.sh" && nvm install ${NODE_VERSION} && \
    nvm alias default ${NODE_VERSION} && nvm use default && \
    which node && node -v && npm -v

# Hack to discover the minor version: e.g. /bin/versions/node/v26.2.0/bin/node
# Derive from ${NODE_VERSION} so a future Node bump is a one-line ARG change.
RUN cd /bin/versions/node/ && ln -s v${NODE_VERSION}* ${NODE_VERSION}
ENV PATH=$PATH:/bin/versions/node/${NODE_VERSION}/bin/

# Install global packages
# ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
# ENV PATH=$PATH:/usr/local/share/npm-global/bin
ARG WRANGLER_VERSION=latest
RUN npm install -g wrangler@${WRANGLER_VERSION}

# [RRN] Differ in the non-root user we use from the node image:
# ENV MYUSER=node
# ENV MYUSER=ubuntu
ENV MYUSER=root

# Ensure default node user has access to /usr/local/share
RUN mkdir -p /usr/local/share/npm-global && \
  chown -R $MYUSER:$MYUSER /usr/local/share

ARG USERNAME=$MYUSER

# [RRN] Seems unimportant. We mount home dir from host anyway.
# Persist bash history.
# RUN SNIPPET="export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
  # && mkdir /commandhistory \
  # && touch /commandhistory/.bash_history \
  # && chown -R $USERNAME /commandhistory

# Set `DEVCONTAINER` environment variable to help with orientation
ENV DEVCONTAINER=true

# [RRN] Uh, I don't know why claude needs to be opinionated about shell..
# Set the default shell to zsh rather than sh
# ENV SHELL=/bin/zsh

# Set the default editor and visual
ENV EDITOR=nano
ENV VISUAL=nano

# Default powerline10k theme
# ARG ZSH_IN_DOCKER_VERSION=1.2.0
# RUN sh -c "$(wget -O- https://github.com/deluan/zsh-in-docker/releases/download/v${ZSH_IN_DOCKER_VERSION}/zsh-in-docker.sh)" -- \
#   -p git \
#   -p fzf \
#   -a "source /usr/share/doc/fzf/examples/key-bindings.zsh" \
#   -a "source /usr/share/doc/fzf/examples/completion.zsh" \
#   -a "export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
#   -x


# [RRN] basic additiions I like everywhere.
# psmisc has killall:
RUN apt-get install -y time parallel hyperfine bc emacs gnuplot psmisc ssh

# [RRN] Python is so universal for scripting...
RUN apt-get install -y python3 pip python3-venv
RUN python3 -m venv /opt/venv
RUN /opt/venv/bin/python3 -m pip install uv

# Bake the Python packages the dev harness and the validation scheduler need.
# /opt/venv lives on the discarded overlay, so a `pip install` done inside a
# running container is EPHEMERAL: it vanishes on the next recreation, and the
# ops state loader then crashes on every tick and silently falls back to
# defaults (that is exactly what PyYAML going missing did -- ds-3ij3j4), while
# `make harness-test` / `make python-typecheck` cannot run at all (ds-gydnh5).
#   PyYAML  - safe_ci_dag_runner / the ops state loader
#   pytest  - make harness-test
#   mypy    - make python-typecheck
#   pandas  - experiment/plotting scripts
# `make setup` still installs the version-PINNED extras (notably playwright,
# which must match web/package.json exactly); this layer covers only the
# unpinned always-needed set.
RUN /opt/venv/bin/python3 -m pip install PyYAML pytest mypy pandas
# End shared, non-project configuration.

# Create workspace and config directories and set permissions
#RUN mkdir -p /workspace /home/$MYUSER/.claude && \
#  chown -R $MYUSER:$MYUSER /workspace /home/$MYUSER/.claude

# WORKDIR /workspace

# USER $MYUSER
ENV SHELL=/bin/bash
