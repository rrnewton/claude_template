
# Project-specific Dependencies for MTG Forge RS
# Install Dependencies
USER root
RUN apt-get update && apt-get install -y maven openjdk-21-jdk-headless

# For git push and pull:
RUN apt-get install -y ssh

# For plotting
RUN apt-get install -y python3-pandas python3-matplotlib

# For performance profiling and monitoring:
# Install perf (linux-tools) for system performance analysis
# Note: perf functionality may be limited in WSL2/containers due to kernel restrictions
RUN apt-get install -y linux-tools-common linux-tools-generic

# Keep it out of the home dir because we will mount that from host:
# RUN apt-get install -y golang

# To force rebuild from here, pass --build-arg CACHEBUST=$(date +%s), 
ARG CACHEBUST

# RUN mkdir -p /opt/local/bin && \
#     export GOBIN="/opt/local/bin" && \
#     git clone https://github.com/rrnewton/beads /tmp/beads && \
#     cd /tmp/beads && git checkout rrn-main &&  \
#     go build -o /opt/local/bin/bd ./cmd/bd
#  This would be easier but gets an error.
#    go install github.com/rrnewton/beads/cmd/bd@rrn-main
#    go install github.com/steveyegge/beads/cmd/bd@latest


ENV IS_SANDBOX=1
# USER $MYUSER
ENV PATH="$PATH:$HOME/bin"
ENV PATH="$PATH:/opt/cargo/bin"

# ADD --chown=node:node dot-claude-init /home/node/.claude/
# Share the config directory from the host:
# VOLUME [ "/home/node/.claude" ]
# dot-claude /home/node/.claude/

