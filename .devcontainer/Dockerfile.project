# ARG GID=1000
# Create a non-root user (recommended for security)
#RUN # groupadd --gid $GID $MYUSER && \
    # useradd -m -u $UID --ingroup $GID -s /bin/bash $MYUSER && \
#    echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

RUN mkdir -m 0755 /nix && chown $MYUSER /nix

# Switch to the non-root user
USER $MYUSER

# Install Nix (single-user installation without daemon)
# The --no-daemon flag is crucial for Docker environments without systemd
RUN sh -c "$(curl -L https://nixos.org/nix/install)" -- --no-daemon

# Add Nix to the user's PATH (important for using Nix commands)
ENV PATH="/home/$USERNAME/.nix-profile/bin:$PATH"

# (Optional) Enable experimental features like flakes
# This requires creating the directory and adding the configuration
RUN mkdir -p /home/$USERNAME/.config/nix && \
    echo "experimental-features = nix-command flakes" >> /home/$USERNAME/.config/nix/nix.conf
