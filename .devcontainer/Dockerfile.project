
USER root

# Keep it out of the home dir because we will mount that from host:
RUN apt-get install rustup
ENV CARGO_HOME=/opt/cargo
ENV RUSTUP_HOME=/opt/multirust
RUN mkdir -p "$CARGO_HOME" && rustup toolchain install stable

RUN cargo install cargo-heaptrack cargo-nextest
RUN apt-get install -y heaptrack ncdu inetutils-ping stress-ng

RUN apt-get install -y linux-tools-common linux-tools-generic python3-pandas python3-matplotlib

# Let the makefile install python deps with pip...
# RUN /opt/venv/bin/python3 -m pip install yaml

# rt-app needs
# dnf install -y autoreconf libtool.x86_64 aclocal json-c-devel.x86_64 json-c.x86_64
