// DeepScry dev container.
//
// [revival 2026-06-16 mtg-idscc6] MULTI-WORKTREE AWARENESS
// -------------------------------------------------------------------------
// This checkout can be used in two shapes:
//
//   * STANDALONE  — a plain `deepscry` clone, opened on its own. The repo
//     root IS the workspace; mounting just that checkout is enough.
//
//   * MULTI-WORKTREE — `deepscry` is a *submodule* of a bigger "dev-deepscry"
//     PARENT harness that also holds `worktrees/` (slot checkouts +
//     `worktrees/ACTIVE.md`) and `experiments/`. To see the registry and
//     sibling worktrees from inside the container, the PARENT must be mounted,
//     not just the one checkout.
//
// RELIABLE detection check (run from the deepscry checkout root) — multi-worktree
// iff EITHER of these holds:
//   1. `git rev-parse --show-superproject-working-tree` is NON-EMPTY
//      (deepscry is a submodule of the parent), OR
//   2. the parent dir (`..`) contains `worktrees/ACTIVE.md`.
// Standalone iff BOTH are absent.
//
//   sup=$(git rev-parse --show-superproject-working-tree 2>/dev/null)
//   if [ -n "$sup" ] || [ -f ../worktrees/ACTIVE.md ]; then echo multi-worktree; else echo standalone; fi
//
// The Makefile (`make run`) already does the right thing for BOTH shapes: it
// mounts `..` (the parent of `.devcontainer`) as the dynamic WORKDIR, so in a
// multi-worktree layout the parent harness — worktrees/ + ACTIVE.md +
// experiments/ — is visible. The mounts below mirror that for the VS Code
// "Reopen in Container" path:
//
//   * workspaceMount  -> the opened folder (the deepscry checkout) at /workspace.
//   * mounts[parent]  -> the dev-deepscry PARENT at /dev-deepscry, so the
//     worktree registry + experiments are reachable in the multi-worktree case.
//     In a standalone clone `..` is just the clone's parent dir and the mount is
//     harmless (nothing in the project depends on it). To DROP it for a strict
//     standalone setup, delete the `/dev-deepscry` line from `mounts`.
{
  "name": "Claude Code Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/Los_Angeles}",
      "CLAUDE_CODE_VERSION": "latest",
      "WORKDIR": "/workspace"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "root",
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-code-config-${devcontainerId},target=/root/.claude,type=volume",
    // [multi-worktree] Mount the dev-deepscry PARENT so worktrees/ + ACTIVE.md +
    // experiments/ are visible from inside the container. See the header note for
    // the standalone-vs-multi-worktree detection check.
    "source=${localWorkspaceFolder}/..,target=/dev-deepscry,type=bind,consistency=delegated"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/root/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
