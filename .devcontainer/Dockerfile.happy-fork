# [RRN] Run my version, but cannot do it in a one-liner because of build step:

RUN git clone --depth=1 https://github.com/rrnewton/happy-cli.git /usr/happy && \
      cd /usr/happy && npm install && npm run build && npm install -g .

ENV HAPPY_HOME_DIR="$HOME/.happy"
ENV HAPPY_SERVER_URL="http://ffh.duckdns.org:3005"
ENV HAPPY_WEBAPP_URL="http://ffh.duckdns.org:8081"
