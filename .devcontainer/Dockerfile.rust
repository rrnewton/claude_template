
# Keep it out of the home dir because we will mount that from host:
# [revival 2026-06-16] added `update` + `-y` (was bare `apt-get install rustup`).
RUN apt-get update && apt-get install -y rustup
ENV CARGO_HOME=/opt/cargo
ENV RUSTUP_HOME=/opt/multirust
RUN mkdir -p "$CARGO_HOME" && rustup toolchain install nightly
# RUN mkdir -p "$CARGO_HOME" && rustup toolchain install stable

# Install my minibeads tool for issue tracking.
# [revival 2026-06-16] Was pinned --tag v0.15; now fetch the latest from the
# default branch so `mb` is always newest. To re-pin, swap --branch main for --tag vX.Y.
RUN cargo install --git https://github.com/rrnewton/minibeads --branch main && \
    ln -s /opt/cargo/bin/mb /opt/cargo/bin/bd

RUN apt-get install -y heaptrack
# [revival 2026-06-16] nextest now REFUSES `cargo install` without --locked
# (locked-tripwire compile_error), so it must be a separate invocation (a single
# cargo install applies one set of flags to all crates in the call).
RUN cargo install cargo-heaptrack flamegraph
RUN cargo install --locked cargo-nextest

# mdbook builds the user guide that scripts/deploy-cloud.sh ships with the site.
# BAKED, not hand-installed (ds-3ij3j4): an mdbook dropped into $HOME/bin looks
# present from an agent shell -- whose PATH is richer -- and is invisible to the
# deploy script and to cron, so the deploy fails with "mdbook not found on PATH"
# on a box where `command -v mdbook` had just answered happily.
# Verify the way the rest of the system sees it: env -i bash -lc 'command -v mdbook'
RUN cargo install --locked mdbook
