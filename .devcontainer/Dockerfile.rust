
# Keep it out of the home dir because we will mount that from host:
# [revival 2026-06-16] added `update` + `-y` (was bare `apt-get install rustup`).
RUN apt-get update && apt-get install -y rustup
ENV CARGO_HOME=/opt/cargo
ENV RUSTUP_HOME=/opt/multirust
RUN mkdir -p "$CARGO_HOME" && rustup toolchain install nightly
# RUN mkdir -p "$CARGO_HOME" && rustup toolchain install stable

# minibeads (mb) is installed in Dockerfile.refresh so it stays current.

RUN apt-get install -y heaptrack
# [revival 2026-06-16] nextest now REFUSES `cargo install` without --locked
# (locked-tripwire compile_error), so it must be a separate invocation (a single
# cargo install applies one set of flags to all crates in the call).
RUN cargo install cargo-heaptrack flamegraph
RUN cargo install --locked cargo-nextest
